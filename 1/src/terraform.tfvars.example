# Заполните своими значениями и сохраните копию как terraform.tfvars.
cloud_id  = "YOUR_CLOUD_ID"
folder_id = "YOUR_FOLDER_ID"

# Публичный SSH-ключ пользователя ubuntu.
metadata = {
  "serial-port-enable" = "1"
  "ssh-keys"           = "ubuntu:ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_KEY terraform-homework"
}
